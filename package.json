{
  "name": "bonacci",
  "version": "0.1.0",
  "description": "An example library and CLI for generating a Fibonacci sequence",
  "keywords": [
    "fibonacci",
    "math"
  ],
  "homepage": "https://github.com/leonardo/bonacci#readme",
  "bugs": {
    "url": "https://github.com/leonardo/bonacci/issues",
    "email": "leonardo@bonacci.com"
  },
  "repository": "github:leonardo/bonacci",
  "license": "Unlicense",
  "author": "Leonardo Bonacci <leonardo@bonacci.com>",
  "exports": {
    ".": {
      "types": "dist/index.d.ts",
      "import": "dist/index.js"
    }
  },
  "type": "module",
  "bin": "dist/cli.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "yargs": "^18.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^26.6.3",
    "@types/yargs": "^17.0.35",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-plugin-jsdoc": "^65.1.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.9",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.21.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.28.4"
