{
  "name": "bonacci",
  "version": "0.0.0",
  "description": "An example library and CLI for generating a Fibonacci sequence",
  "keywords": [
    "fibonacci",
    "math"
  ],
  "homepage": "https://github.com/leonardo/bonacci#readme",
  "bugs": {
    "url": "https://github.com/leonardo/bonacci/issues",
    "email": "leonardo@bonacci.com"
  },
  "repository": "github:leonardo/bonacci",
  "license": "Unlicense",
  "author": "Leonardo Bonacci <leonardo@bonacci.com>",
  "exports": {
    ".": {
      "types": "dist/index.d.ts",
      "import": "dist/index.js"
    }
  },
  "type": "module",
  "bin": "dist/cli.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "yargs": "^18.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tsconfig/node26": "^26.0.2",
    "@types/node": "^26.6.6",
    "@types/yargs": "^17.0.35",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "eslint-plugin-jsdoc": "^65.5.4",
    "jiti": "^2.7.0",
    "prettier": "^3.10.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=26"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.23.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^26.13.1",
      "onFail": "download"
    }
  }
}
